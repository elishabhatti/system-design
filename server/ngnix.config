events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;

    # Rate limiting zone (10 req/sec per IP, 10MB memory)
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

    # Node.js cluster
    upstream nodejs_cluster {
        # Consistent hashing on userId (same user -> same server)
        hash $arg_userId consistent;

        server 127.0.0.1:3001 max_fails=3 fail_timeout=30s;
        server 127.0.0.1:3002 max_fails=3 fail_timeout=30s;
    }

    # HTTP -> HTTPS redirect
    server {
        listen 80;
        server_name localhost;
        return 301 https://$host$request_uri;
    }

    # HTTPS server
    server {
        listen 443 ssl;
        http2 on;
        server_name localhost;

        ssl_certificate     /etc/nginx/certs/localhost+1.pem;
        ssl_certificate_key /etc/nginx/certs/localhost+1-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        # Allow large payloads (video uploads)
        client_max_body_size 500M;

        # General proxy setup
        location / {
            proxy_pass http://nodejs_cluster;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # Rate-limited endpoint
        location /api/views/ {
            limit_req zone=api_limit burst=20 nodelay;

            proxy_pass http://nodejs_cluster;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}