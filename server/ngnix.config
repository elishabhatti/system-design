events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;

    # Define rate limiting zone (10 requests per second with a 10MB zone memory)
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

    # Upstream block for Node.js app cluster
    upstream nodejs_cluster {
        # Sticky sessions via IP hash (remove ip_hash to test standard round-robin)
        ip_hash;

        server 127.0.0.1:3001 max_fails=3 fail_timeout=30s;
        server 127.0.0.1:3002 max_fails=3 fail_timeout=30s;
    }

    server {
        listen 80;
        server_name localhost;

        # Allow large payloads (e.g., video file uploads)
        client_max_body_size 500M;

        # General proxy setup
        location / {
            proxy_pass http://nodejs_cluster;

            # Standard Proxy Headers
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # Rate limiting rule for video view increment / sensitive API endpoints
        location /api/views/ {
            limit_req zone=api_limit burst=20 nodelay;

            proxy_pass http://nodejs_cluster;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
