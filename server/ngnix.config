events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;

    # WebSocket ke liye sahi Connection header
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Har request kis server pe gayi, ye log hoga
    log_format lb '$upstream_addr $request_time $upstream_response_time "$request"';
    access_log /var/log/nginx/lb.log lb;

    # Rate limiting zone (10 req/sec per IP, 10MB memory)
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

    upstream nodejs_cluster {
        # Ek time pe sirf ek line active rakho
        hash $arg_userId consistent;      # Consistent Hashing
        # least_conn;                     # Least Connections
        # ip_hash;                        # IP Hash
        # random two least_conn;          # Power of Two Choices
        # (kuch nahi likhoge to Round Robin)

        server 127.0.0.1:3000 max_fails=3 fail_timeout=30s;
        server 127.0.0.1:3001 max_fails=3 fail_timeout=30s;
    }

    server {
        listen 80;
        server_name localhost;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2;
        server_name localhost;

        ssl_certificate     /etc/nginx/certs/localhost+1.pem;
        ssl_certificate_key /etc/nginx/certs/localhost+1-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        client_max_body_size 500M;

        location / {
            proxy_pass http://nodejs_cluster;

            # Upload seedha backend tak stream ho
            proxy_request_buffering off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location /api/views/ {
            limit_req zone=api_limit burst=20 nodelay;

            proxy_pass http://nodejs_cluster;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}