datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  channelName   String   
  email         String   @unique
  password      String   
  avatarUrl     String?  
  bio           String?  @db.Text
  bannerUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  videos        Video[]  
  views         View[]   
  likes         Like[]
  comments      Comment[]

  subscribers       Subscription[] @relation("UserSubscriptions")
  subscriptions     Subscription[] @relation("UserFollowing")
  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("NotificationSender")
}

model Subscription {
  id           String   @id @default(uuid())
  subscriberId String   
  channelId    String   

  subscriber   User     @relation("UserFollowing", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel      User     @relation("UserSubscriptions", fields: [channelId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@unique([subscriberId, channelId]) 
  // 👉 OPTIMIZATION: Subscriptions lookup fast karne ke liye indexes
  @@index([subscriberId])
  @@index([channelId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId]) 
  @@index([userId]) // 👉 OPTIMIZATION: User ki liked videos nikalne ke liye
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId]) 
  @@index([userId]) // 👉 OPTIMIZATION: User ke comments track karne ke liye
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // Jisko notification jaani hai (Channel owner)
  senderId  String   // Jisne action kiya (Subscriber ya Commenter)
  type      String   // 'SUBSCRIBE' ya 'COMMENT'
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)

  // 👉 OPTIMIZATION: User ki notifications fast fetch karne ke liye
  @@index([userId])
  @@index([read])
}

model Video {
  id            String    @id @default(uuid())
  title         String
  description   String?   @db.Text
  filename      String
  filepath      String
  filesize      Int
  mimetype      String
  thumbnailUrl  String?
  category      String?   @default("General")
  tags          String?   
  isMadeForKids Boolean   @default(false)
  ageRestricted Boolean   @default(false)
  visibility    String    @default("private") 
  scheduledFor  DateTime?
  views         Int       @default(0) 
  uploadedAt    DateTime  @default(now())

  userId        String    
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewsRelation View[]    
  likes         Like[]
  comments      Comment[]

  // 👉 OPTIMIZATION: User ki videos aur category/upload date ke mutabiq filtering fast karne ke liye
  @@index([userId])
  @@index([category])
  @@index([uploadedAt])
}

model View {
  id      String @id @default(uuid())
  userId  String
  videoId String
  user    User   @relation(fields: [userId], references: [id])
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  // 👉 OPTIMIZATION: View tracking check karne ke liye index
  @@index([videoId])
  @@index([userId])
}