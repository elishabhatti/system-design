datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  channelName String   
  email       String   @unique
  password    String   
  avatarUrl   String?  
  bio         String?  @db.Text
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  videos      Video[]  
  views       View[]   

  // Subscriptions relations
  subscribers   Subscription[] @relation("UserSubscriptions")
  subscriptions Subscription[] @relation("UserFollowing")
}

model Subscription {
  id           String   @id @default(uuid())
  subscriberId String   // Jo subscribe kar raha hai
  channelId    String   // Jiss channel ko subscribe kiya ja raha hai

  subscriber   User     @relation("UserFollowing", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel      User     @relation("UserSubscriptions", fields: [channelId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@unique([subscriberId, channelId]) // Ek user ek channel ko aik hi baar subscribe kar sakta hai
}

model Video {
  id            String    @id @default(uuid())
  title         String
  description   String?   @db.Text
  filename      String
  filepath      String
  filesize      Int
  mimetype      String
  thumbnailUrl  String?
  category      String?   @default("General")
  tags          String?   
  isMadeForKids Boolean   @default(false)
  ageRestricted Boolean   @default(false)
  visibility    String    @default("private") 
  scheduledFor  DateTime?
  views         Int       @default(0) // <-- Yeh raha correct default value
  uploadedAt    DateTime  @default(now())

  userId        String    
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewsRelation View[]    // Relation name distinguish karne ke liye viewsRelation rakh sakte hain
}

model View {
  id      String @id @default(uuid())
  userId  String
  videoId String
  user    User   @relation(fields: [userId], references: [id])
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}